# ==============================================================================
# CONFIGURACIÓN DEL MICROSERVICIO WHATSAPP BRIDGE (EL ARCA DISPLAY CLUB)
# ==============================================================================

# Puerto local o asignado por Render / Koyeb
PORT=3001

# URI de tu base de datos MongoDB Atlas (la misma que usas en el proyecto de Vercel)
# Sirve para guardar la sesión de WhatsApp y no tener que escanear el QR cada vez que se reinicie
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/el_arca_database?retryWrites=true&w=majority

# URL del Webhook en tu Vercel
VERCEL_WEBHOOK_URL=https://elarca-displayclub.vercel.app/api/whatsapp/webhook

# Secreto de seguridad compartido entre el Bridge y Vercel
BRIDGE_SECRET=el_arca_bridge_secret_2026

# Teléfono del Administrador / Dueño (solo números, con código de Cuba 53)
ADMIN_PHONE=5352031972

# Teléfono del Bot / Tienda (el número que se va a vincular por QR)
BOT_PHONE=5363657247

# Clave para ver el QR en la página web /scan (evita accesos no deseados)
SCAN_ACCESS_KEY=elarca2026
