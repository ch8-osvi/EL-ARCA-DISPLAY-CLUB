# Puente local. No subir el archivo .env ni las carpetas auth_session/spool.
PORT=7860
VERCEL_WEBHOOK_URL=https://elarca-displayclub.vercel.app/api/whatsapp/webhook
# Debe coincidir con WHATSAPP_BRIDGE_SECRET de Vercel. Mínimo 32 caracteres aleatorios.
BRIDGE_SECRET=
# Clave del QR local, mínimo 16 caracteres. Se introduce por formulario, nunca por URL.
SCAN_ACCESS_KEY=
# La identidad del bot se obtiene de la sesión de WhatsApp.
